PORT=3000
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
RUNNER_IMAGE=codewise-runner:teaching-v2
# Keep this at 1 for the initial deployment on a 2 GB server.
RUNNER_MAX_CONCURRENT=3

# Local SQLite database; keep runtime data outside the source directory.
DATABASE_PATH=../Data/learning.sqlite
HOST=127.0.0.1
SESSION_SECURE=false
# Optional: initial account, created only when the username does not exist.
BOOTSTRAP_USERNAME=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_DISPLAY_NAME=

# Set to loopback only when a local reverse proxy is configured.
TRUST_PROXY=
