[Unit]
Description=CodeClario learning platform
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=codeclario
Group=codeclario
SupplementaryGroups=docker
WorkingDirectory=/opt/codeclario/app
EnvironmentFile=/etc/codeclario.env
Environment=PATH=/opt/codeclario/runtime/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/codeclario/runtime/node/bin/node --import ./node_modules/tsx/dist/loader.mjs server/index.ts --production
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
